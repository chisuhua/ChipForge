//   - 链接 CppHDL: cmake target_link_libraries(... cpp-hdl::ch)
//
// 关联:
//   - openspec/changes/plugin-elaboration-substrate/{proposal,tasks}.md
//   - docs/audit/cppHDL-maturity-audit.md
//   - ip/cpu/cpu_factory_chmem.h (M4 集成骨架)
//   - tests/framework/test_cppHDL_hello_poc.cpp (W0 PoC 参考)
//
// 注: 本文件是 M4+M5 集成骨架, 完整 build + Verilator 仿真需 build 环境.
//      实际 M5 验证需在下次会话 (需 cmake 配置 + CppHDL link + Verilator).

#define CF_PLUGIN_USE_CH_MEM
// #define CF_PLUGIN_USE_FSM_EXEMPT  // PoC 阶段无 FSM, 不需要

#include "catch_amalgamated.hpp"

#include <cstdint>
#include <fstream>
#include <memory>
#include <string>

#include <ch.hpp>
#include <component.h>
#include <core/context.h>
#include <core/reg.h>
