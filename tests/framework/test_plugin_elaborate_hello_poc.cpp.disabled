// tests/framework/test_plugin_elaborate_hello_poc.cpp
//
// Phase 6c M1/W2 第一个 hello.v PoC
// 作者: ChipForge Plugin Team
// 最后修改日期: 2026-09-16
//
// 目的: 端到端验证 cf::plugin 的 elaboration 语义
//   - CF_PLUGIN_USE_CH_MEM 下 uint_t<N> = ch::core::ch_uint<N>
//   - PayloadStore cell 装 ch 代理
//   - PipeBuilder::elaborate() 执行所有 at_stage 闭包一次, 发射 lnode DAG
//   - ch::toVerilog 把 lnode DAG 输出 Verilog
//
// 编译:
//   - 必须 -DCF_PLUGIN_USE_CH_MEM 打开 CH_MEM 模式
//   - 链接 CppHDL: cmake target_link_libraries(... cpp-hdl::ch)
//
// 关联:
//   - openspec/changes/plugin-elaboration-substrate/proposal.md
//   - tests/framework/test_cppHDL_hello_poc.cpp (W0 PoC, 不依赖 cf::plugin)
//   - docs/audit/cppHDL-maturity-audit.md

#define CF_PLUGIN_USE_CH_MEM  // 强制开启 CH_MEM 模式 (M1 PoC 必须)

#include "catch_amalgamated.hpp"

#include <cstdint>
#include <memory>
#include <string>

// CppHDL 头文件
#include <ch.hpp>
#include <component.h>
#include <core/context.h>
#include <core/reg.h>
#include <core/uint.h>
#include <core/bool.h>
#include <codegen_verilog.h>

// cf::plugin (Phase 6c CH_MEM 模式)
#include "cf/plugin/plugin_base.h"
#include "cf/plugin/pipe_builder.h"
#include "cf/plugin/payload.h"
#include "cf/plugin/uint_t.h"

using namespace cf;
using namespace cf::plugin;
using namespace ch;
using namespace ch::core;

namespace {

// =========================================================================
// HelloPayload: 静态 Payload Key (VexRiscv Stageable[T] 模式)
//
// 闭包通过 `node(key)` 访问 per-stage 信号实体.
// 在 CH_MEM 模式下, key 装 ch_uint<N>/ch_bool, elaboration 期发射 lnode DAG.
// =========================================================================
namespace keys {

// 输入端: 8-bit 加法输入
inline Payload<uint_t<8>> A{"a"};
inline Payload<uint_t<8>> B{"b"};

// 中间: result_reg (ch_reg, always_ff in Verilog)
inline Payload<uint_t<8>> RESULT_REG{"result_reg"};

// 输出: 组合 sum = a + b
inline Payload<uint_t<8>> SUM{"sum"};

}  // namespace keys

// =========================================================================
// HelloPlugin: 第一个 Plugin (10 行 at_stage 闭包)
//
// 描述: 在 "stage_a" 闭包内执行 ch_uint 加法, 写到 result_reg;
//       在 "stage_b" 闭包内把 result_reg 读到 sum 输出.
//
// 注: PoC 阶段只有 1 个 stage (stage_a) 做核心逻辑, stage_b 是 PoC #2 的
//     第二 stage (M2 阶段实装自动 stage 间 ch_reg 插入后会有真实双 stage).
// =========================================================================
class HelloPlugin : public PluginBase {
 public:
  void build(PipeBuilder& pb) override {
    // PoC #1: 单一 stage, a + b → result_reg (ch_reg) + sum (组合输出)
    pb.at_stage("stage_a", Phase::NORMAL, [&pb]() {
      auto& n_a = pb.node_of_logic_stage("stage_a")->operator()(keys::A);
      auto& n_b = pb.node_of_logic_stage("stage_a")->operator()(keys::B);
      auto& n_sum = pb.node_of_logic_stage("stage_a")->operator()(keys::SUM);

      // Combinational: sum = a + b
      n_sum = n_a + n_b;

      // Sequential: result_reg <<= a + b (下一拍捕获)
      // 注: PoC 阶段直接写到 RESULT_REG, 演示 ch_reg 语义
      // M2 阶段: PipeBuilder.elaborate() 会自动在 stage 间插 ch_reg
      auto& n_reg = pb.node_of_logic_stage("stage_a")->operator()(keys::RESULT_REG);
      n_reg <<= (n_a + n_b);
    });
  }
};

}  // namespace

// =========================================================================
// M1 PoC: 端到端 hello.v 生成
//
// 用法:
//   - 创建 ch::core::context (顶层 elaboration 上下文)
//   - 构造 PipeBuilder (CH_MEM 模式要求传 context*)
//   - 注册 HelloPlugin → build() 触发 plugin 的 setup/build
//   - 调用 elaborate() 一次性执行所有 at_stage 闭包, 发射 lnode DAG
//   - 调用 to_verilog() 输出 .v 文件
//
// 预期 Verilog 内容:
//   - module hello_poc (顶层 Component 名)
//   - port list: a, b (input), sum (output)
//   - always_ff (result_reg <<= a + b)
//   - assign sum = a + b
// =========================================================================
TEST_CASE("plugin_elaborate_hello_poc", "[framework][plugin][m1][poc]") {
  // 1. 创建 elaboration 上下文
  ch::core::context elaboration_ctx("hello_poc");

  // 2. 构造 PipeBuilder (CH_MEM 模式要求 context*)
  PipeBuilder pb(&elaboration_ctx);

  // 3. 注册 + build plugin
  pb.register_plugin(std::make_unique<HelloPlugin>());
  pb.build();   // 触发 setup/build, plugin 在 build() 中调用 at_stage 注册闭包

  // 4. elaboration: 一次性执行所有 at_stage 闭包, 发射 lnode DAG
  pb.elaborate();

  // 5. 输出 Verilog
  const std::string out_file = "/tmp/plugin_hello_poc.v";
  pb.to_verilog(out_file);

  // 6. 验证文件存在且含期望内容
  std::ifstream f(out_file);
  REQUIRE(f.is_open());
  std::stringstream ss;
  ss << f.rdbuf();
  std::string verilog = ss.str();
  REQUIRE(!verilog.empty());
  REQUIRE(verilog.find("module") != std::string::npos);
  // ch_reg <<= a + b 发射 always_ff
  REQUIRE(verilog.find("always") != std::string::npos);

  SUCCEED("Phase 6c M1 PoC: at_stage 闭包 elaboration 发射 lnode DAG, toVerilog 输出 hello.v (长度=" +
          std::to_string(verilog.size()) + ")");
}

// =========================================================================
// M1 PoC #2: CtrlLink 在 CH_MEM 模式下接收 ch_bool (预演 M2)
//
// W0 审计发现 ch_bool 有 explicit operator bool() (core/bool.h:48).
// C++17 contextual conversion 允许 if(ch_bool_var) 编译通过, 但运行期语义需验证.
// 本 PoC 验证 CtrlLink::halt_when(ch_bool) 能接收 ch_bool 并正常调用 should_halt().
// =========================================================================
TEST_CASE("plugin_elaborate_ctrl_link_chbool", "[framework][plugin][m1][poc]") {
  // 准备 ch_bool halt 条件 (PoC 阶段简单: 直接初始化为 false)
  ch_bool halt_cond(false, "halt_cond");

  // 创建 CtrlLink, 注册 halt_when(ch_bool)
  auto ctrl_link = std::make_shared<CtrlLink>();
  ctrl_link->halt_when(halt_cond);

  // 验证 should_halt() 返回 false (halt_cond 是 false)
  REQUIRE(ctrl_link->should_halt() == false);

  SUCCEED("Phase 6c M1 PoC: CtrlLink::halt_when(ch_bool) 编译通过 + 行为正确");
}