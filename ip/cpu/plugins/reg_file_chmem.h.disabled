// ip/cpu/plugins/reg_file_chmem.h
//
// 功能描述: RegFilePlugin (CH_MEM 模式) — 通用寄存器堆的 elaboration 版本
// 作者: ChipForge Plugin Team
// 最后修改日期: 2026-09-16 (Phase 6c M3 PoC)
//
// 设计:
//   - 仅在 CF_PLUGIN_USE_CH_MEM 下编译（elaboration 路径）
//   - 32 个寄存器用 32 个 ch_reg<ch_uint<XLEN>> 实现（不用 array_store）
//   - x0 屏蔽用 select()：读返回 select(idx==0, 0, reg[idx])
//   - 写用 reg[rd_idx]->next = select(we && rd_idx != 0, rd_data, reg[rd_idx])
//   - 编译开关: TLM 模式走 ip/cpu/plugins/reg_file.h；CH_MEM 模式走本文件
//
// 借鉴:
//   - CppHDL/examples/riscv-mini/src/rv32i_regfile.h (318 行手写 RTL 实现)
//   - CppHDL/include/chlib/state_machine.h 的 Phase/Stage 模型
//
// 约束:
//   - 必须 -DCF_PLUGIN_USE_CH_MEM 打开
//   - 不依赖 cpptlm（纯 ch::core + cf::plugin）
//   - D4 合规: 无 tick(), 用 at_stage() 注册闭包, 闭包内 select  替代 if/else
//
// 注: 本文件是 M3 PoC 的"正确形态"骨架; 完整 5 级流水线连接需 M4 + cpu_factory 配合.

#ifndef CF_IP_CPU_PLUGINS_REG_FILE_CHMEM_H
#define CF_IP_CPU_PLUGINS_REG_FILE_CHMEM_H

#ifndef CF_PLUGIN_USE_CH_MEM
#error "reg_file_chmem.h requires CF_PLUGIN_USE_CH_MEM"
#endif

#include <array>
#include <cstddef>
#include <cstdint>
#include <type_traits>

#include <ch.hpp>
#include <component.h>
#include <core/context.h>
#include <core/reg.h>
#include <core/uint.h>
#include <core/bool.h>
#include <core/operators.h>

#include "cf/plugin/plugin_base.h"
#include "cf/plugin/pipe_builder.h"
#include "cf/plugin/uint_t.h"
#include "ip/cpu/core/payload_common.h"

using namespace cf::plugin;
using namespace ch;
using namespace ch::core;

namespace cf {
namespace cpu {
namespace plugins {

// ============================================================================
// RegFilePlugin (CH_MEM): 32 个 ch_reg<ch_uint<XLEN>> + x0 select 屏蔽
// ============================================================================
template <typename T, std::size_t N_REGS = 32, std::size_t N_THREADS = 1>
class RegFilePlugin : public PluginBase {
  static_assert(std::is_unsigned<T>::value,
                "RegFilePlugin<T>: T must be unsigned");
  static_assert(N_REGS == 32, "CH_MEM PoC: 固定 32 寄存器 (RISC-V spec)");

 public:
  static constexpr std::size_t kNumRegs = N_REGS;
  static constexpr std::size_t kXlenBits = sizeof(T) * 8;
  static constexpr std::size_t kAddrBits = 5;  // log2(32) = 5

  RegFilePlugin() = default;
  ~RegFilePlugin() override = default;

  RegFilePlugin(const RegFilePlugin&) = delete;
  RegFilePlugin& operator=(const RegFilePlugin&) = delete;

  void setup(PipeBuilder& /*pb*/) override {}

  void build(PipeBuilder& pb) override {
    using KeyType = cf::cpu::core::payload::keys<T, kXlenBits>;
    using addr_t = ch_uint<kAddrBits>;

    // ------------------------------------------------------------------
    // CH_MEM 模式: 32 个 ch_reg 声明 (elaboration 期建 lnode DAG)
    // 注: 这些声明必须在 describe() 内 (elaboration ctx 已 swap); 但
    //     build() 阶段 ctx 还未 swap, 所以 ch_reg 构造延迟到 at_stage 闭包内.
    //
    // 实际策略: 把 ch_reg 构造移到 at_stage("decode", NORMAL, lambda):
    //   - 每次 elaboration 一次, 32 个 ch_reg 在 ctx DAG 中累积
    //   - 每个 ch_reg  对应一个 always_ff 块 (Verilog 输出)
    // ------------------------------------------------------------------
    pb.at_stage("decode", Phase::NORMAL, [this, &pb]() {
      // CH_MEM 模式: 实例化 32 个 ch_reg<ch_uint<kXlenBits>>
      static thread_local std::array<ch_reg<ch_uint<kXlenBits>>, kNumRegs>
          regs{};

      // 首次调用初始化 (thread_local 保证 elaboration 只一次)
      static thread_local bool initialized = false;
      if (!initialized) {
        initialized = true;
        for (std::size_t i = 0; i < kNumRegs; ++i) {
          regs[i] = ch_reg<ch_uint<kXlenBits>>(
              ch_uint<kXlenBits>(0_d),
              ("reg_" + std::to_string(i)).c_str());
        }
      }

      // 从 PayloadStore 读 RS1/RS2 索引 + DECODE 信息
      auto* n = pb.node_of_logic_stage("decode").get();
      if (n) {
        const auto& dec = n->operator()(KeyType::DECODE);
        addr_t rs1_addr = static_cast<addr_t>(dec.rs1_idx);
        addr_t rs2_addr = static_cast<addr_t>(dec.rs2_idx);

        if (dec.reads_rs1) {
          // 32 路 mux: select(addr == i, regs[i], prev)
          // PoC 简化: 直接用 read_reg() 函数 (CH_MEM 模式下需要纯 ch_reg 索引)
          // 完整实现需 32-way select tree (CH_MEM emit mux lnodes)
          ch_uint<kXlenBits> rs1_data(0_d, "rs1_data");
          for (std::size_t i = 1; i < kNumRegs; ++i) {
            rs1_data = select(rs1_addr == addr_t(i), regs[i], rs1_data);
          }
          // x0 永远是 0 (rs1_addr == 0 → rs1_data 保持 init 0)
          n->operator()(KeyType::RS1) = rs1_data;
        }

        if (dec.reads_rs2) {
          ch_uint<kXlenBits> rs2_data(0_d, "rs2_data");
          for (std::size_t i = 1; i < kNumRegs; ++i) {
            rs2_data = select(rs2_addr == addr_t(i), regs[i], rs2_data);
          }
          n->operator()(KeyType::RS2) = rs2_data;
        }
      }
    });

    // 写回阶段: 写 RD 到对应寄存器 (x0 屏蔽)
    pb.at_stage("writeback", Phase::LATE, [this, &pb]() {
      using KeyType = cf::cpu::core::payload::keys<T, kXlenBits>;
      static thread_local std::array<ch_reg<ch_uint<kXlenBits>>, kNumRegs>
          regs{};

      auto* n = pb.node_of_logic_stage("writeback").get();
      if (n) {
        const auto& dec = n->operator()(KeyType::DECODE);
        addr_t rd_addr = static_cast<addr_t>(dec.rd_idx);
        ch_bool we = dec.writes_rd && (rd_addr != addr_t(0));

        // 32 路条件写: reg[i]->next = select(we && rd_addr == i, rd_data, reg[i])
        for (std::size_t i = 1; i < kNumRegs; ++i) {
          ch_bool sel = we && (rd_addr == addr_t(i));
          regs[i] <<= select(sel, n->operator()(KeyType::RD_DATA),
                            regs[i]);
        }
        // x0 (regs[0]) 永远不写, 始终保持 0
      }
    });
  }

  // 单元测试辅助 API (PoC: 与 TLM 版本接口一致)
  T read_reg(std::size_t idx, std::uint8_t /*tid*/ = 0) const {
    // CH_MEM 模式下读寄存器需要 Simulator; PoC 简化: 返回 0
    // 完整实现: ch::Simulator sim(ctx); sim.get_value(regs[idx]);
    (void)idx;
    return T{0};
  }

  void write_reg(std::size_t idx, T value, std::uint8_t /*tid*/ = 0) {
    // CH_MEM 模式下写寄存器需要 at_stage("writeback", ...) 触发
    // 或直接在 describe() 顶层发射 next_value (PoC 不实装)
    (void)idx;
    (void)value;
  }

 private:
  // 注: regs_ array 在 at_stage lambda 内 static thread_local 声明
  //     (不能在 class member 里直接声明 ch_reg 因为需要 active context)
};

}  // namespace plugins
}  // namespace cpu
}  // namespace cf

#endif  // CF_IP_CPU_PLUGINS_REG_FILE_CHMEM_H