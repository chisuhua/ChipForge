{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RISC-V CPU IP Configuration Schema (v2.0 + DSE 扩展)",
  "description": "v2.0 字段 + M4-DSE/M5-DSE 新增字段 (2026-06-17) + M5-DSE superscalar 9 新字段 + 3 字段重命名 (2026-06-22, M5.19). 见 ip/cpu/docs/dse_architecture.md §4",
  "type": "object",
  "properties": {
    "name": {"type": "string", "description": "实例名称"},
    "type": {"type": "string", "const": "cpu"},
    "impl_mode": {
      "type": "string",
      "enum": ["TLM_ONLY", "RTL_ONLY", "COMPARE", "SHADOW"],
      "default": "TLM_ONLY",
      "description": "实现模式"
    },
    "params": {
      "type": "object",
      "properties": {
        "isa": {
          "type": "string",
          "enum": ["rv32i", "rv32im", "rv32imac", "rv64i", "rv64gc"],
          "default": "rv64gc",
          "description": "指令集架构"
        },
        "pipeline_stages": {
          "type": "integer",
          "enum": [3, 5, 7, 10],
          "default": 5,
          "description": "流水线级数 (3=embedded, 5=default, 7=superscalar, 10=deep pipeline)"
        },
        "clock_freq_mhz": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000,
          "default": 100,
          "description": "时钟频率 (MHz)"
        },
        "enable_pmp": {
          "type": "boolean",
          "default": true,
          "description": "启用物理内存保护"
        },
        "enable_mmu": {
          "type": "boolean",
          "default": true,
          "description": "启用 MMU"
        },
        "mmu_mode": {
          "type": "string",
          "enum": ["sv32", "sv39", "sv48"],
          "default": "sv39",
          "description": "虚拟内存模式"
        },
        "branch_predictor": {
          "type": "string",
          "enum": ["static", "bimodal", "gshare", "tournament"],
          "default": "gshare",
          "description": "分支预测器类型"
        },
        "btb_entries": {
          "type": "integer",
          "enum": [16, 32, 64, 128, 256],
          "default": 64,
          "description": "BTB 条目数"
        },
        "icache_latency": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32,
          "default": 1,
          "description": "ICache 命中延迟 (cycle)"
        },
        "dcache_latency": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32,
          "default": 1,
          "description": "DCache 命中延迟 (cycle)"
        },
        "enable_branch_predictor": {
          "type": "boolean",
          "default": true,
          "description": "[M4-DSE 新增] 是否启用分支预测器 (3 级嵌入式可关)"
        },
        "split_if_id": {
          "type": "boolean",
          "default": false,
          "description": "[M4-DSE 新增] 7 级模式把 fetch 拆 IF1/IF2"
        },
        "merge_ex_mem": {
          "type": "boolean",
          "default": false,
          "description": "[M4-DSE 新增] 3 级模式合并 EX+MEM"
        },
        "ghr_bits": {
          "type": "integer",
          "enum": [8, 16],
          "default": 8,
          "description": "[M4-DSE 新增] GShare 全局历史寄存器位数"
        },
        "ext_m": {
          "type": "boolean",
          "default": false,
          "description": "[M4-DSE 新增] RISC-V M 扩展 (MUL/DIV)"
        },
        "ext_a": {
          "type": "boolean",
          "default": false,
          "description": "[M4-DSE 新增] RISC-V A 扩展 (atomic)"
        },
        "ext_f": {
          "type": "boolean",
          "default": false,
          "description": "[M4-DSE 新增] RISC-V F 扩展 (单精度 FPU, stub)"
        },
        "ext_d": {
          "type": "boolean",
          "default": false,
          "description": "[M4-DSE 新增] RISC-V D 扩展 (双精度 FPU, stub)"
        },
        "ext_zicsr": {
          "type": "boolean",
          "default": false,
          "description": "[M4-DSE 新增] RISC-V Zicsr 扩展 (CSR)"
        },
        "ext_zifencei": {
          "type": "boolean",
          "default": false,
          "description": "[M4-DSE 新增] RISC-V Zifencei 扩展"
        },
        "mul_latency": {
          "type": "integer",
          "enum": [1, 3, 5],
          "default": 1,
          "description": "[M5-DSE 新增] MUL 指令延迟 (cycle 数)"
        },
        "use_strict_scoreboard": {
          "type": "boolean",
          "default": true,
          "description": "[M4-DSE 新增] HazardPlugin 严格 scoreboard 模式"
        },
        "collect_stats": {
          "type": "boolean",
          "default": false,
          "description": "[M5-DSE 新增] 是否收集运行统计 (IPC/branch_miss/cache_hit)"
        },
        "n_lanes": {
          "type": "integer",
          "enum": [1, 2, 4, 8],
          "default": 1,
          "description": "[M5-DSE 新增] 执行 lane 数 (与 dispatch_width 等价, 1=byte-identical baseline)"
        },
        "dispatch_width": {
          "type": "integer",
          "enum": [1, 2, 4],
          "default": 1,
          "description": "[M5-DSE 新增] 单 cycle dispatch lane 数 (2-wide superscalar 场景设为 2)"
        },
        "issue_queue_size": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "[M5-DSE 新增] Issue Queue entries 数 (0=关闭 OoO issue, 1=byte-identical baseline)"
        },
        "rob_size": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "[M5-DSE 新增] Reorder Buffer entries 数 (0=关闭 OoO commit)"
        },
        "lsq_size": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "[M5-DSE 新增] Load/Store Queue entries 数 (0=顺序访存)"
        },
        "rename_table_size": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "[M5-DSE 新增] 重命名表项数 (0=不启用寄存器重命名)"
        },
        "retire_width": {
          "type": "integer",
          "enum": [1, 2, 4],
          "default": 1,
          "description": "[M5-DSE 新增] 单 cycle retire lane 数"
        },
        "fetch_width": {
          "type": "integer",
          "enum": [1, 2, 4],
          "default": 1,
          "description": "[M5-DSE 新增] 单 cycle fetch 指令数"
        },
        "commit_width": {
          "type": "integer",
          "enum": [1, 2, 4],
          "default": 1,
          "description": "[M5-DSE 新增] 单 cycle commit 指令数"
        }
      },
      "required": ["isa"],
      "allOf": [
        {"if": {"properties": {"enable_mmu": {"const": true}}}, "then": {"required": ["mmu_mode"]}},
        {"if": {"properties": {"isa": {"enum": ["rv32i", "rv32im", "rv32imac"]}}}, "then": {"properties": {"mmu_mode": {"const": "sv32"}}}},
        {"if": {"properties": {"pipeline_stages": {"const": 3}}}, "then": {"properties": {"branch_predictor": {"enum": ["static", "bimodal"]}}, "btb_entries": {"enum": [16, 32]}}},
        {"if": {"properties": {"pipeline_stages": {"const": 7}}}, "then": {"properties": {"branch_predictor": {"enum": ["gshare", "tournament"]}}}}
      ]
    },
    "ports": {
      "type": "object",
      "description": "外部端口定义",
      "properties": {
        "ibus": {"type": "object"},
        "dbus": {"type": "object"},
        "irq": {"type": "object"}
      }
    },
    "stats": {
      "type": "array",
      "items": {"type": "string"},
      "description": "统计指标列表"
    }
  },
  "required": ["name", "type", "params"],
  "additionalProperties": false
}
