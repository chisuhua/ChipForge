{
  "name": "RiscvCpu_deep_pipeline",
  "type": "cpu",
  "params": {
    "isa": "rv32im",
    "pipeline_stages": 10,
    "clock_freq_mhz": 500,
    "split_if_id": true,
    "enable_branch_predictor": true,
    "branch_predictor": "tournament",
    "btb_entries": 256,
    "ghr_bits": 16,
    "ext_m": true,
    "mul_latency": 5,
    "ext_zicsr": true,
    "ext_f": false,
    "ext_d": false,
    "enable_mmu": false,
    "mmu_mode": "sv32",
    "enable_pmp": true,
    "icache_latency": 2,
    "dcache_latency": 2,
    "use_strict_scoreboard": true,
    "collect_stats": true,
    "dispatch_width": 1,
    "n_lanes": 1,
    "fetch_width": 1,
    "commit_width": 1,
    "retire_width": 1
  },
  "ports": {
    "ibus": {
      "type": "ch_stream",
      "bundle": "MemReqBundle"
    },
    "dbus": {
      "type": "ch_stream",
      "bundle": "MemReqBundle"
    },
    "irq": {
      "type": "signal",
      "width": 16
    }
  },
  "stats": [
    "ipc",
    "branch_miss_rate",
    "cache_hit_rate",
    "cycles",
    "mul_latency_effective",
    "pipeline_depth"
  ],
  "_comment": "cpu-pipeline-tick-fix F2: Bare M-mode bare-metal smoke per openspec/specs/riscv-tests-fixture/spec.md:74-80 (D4 \u51b3\u7b56: \u4fdd\u6301 CPUConfig::enable_mmu \u9ed8\u8ba4 true; \u6d88\u8d39 JSON \u663e\u5f0f false)"
}
