// ip/cpu/cpu_factory_chmem.h
//
// 功能描述: CpuFactory (CH_MEM 模式) — 5 级流水线 RISC-V CPU 集成
// 作者: ChipForge Plugin Team
// 最后修改日期: 2026-09-16 (Phase 6c M4 PoC 集成骨架)
//
// 设计:
//   - 仅在 CF_PLUGIN_USE_CH_MEM 下编译 (elaboration 路径)
//   - 集成 5 级流水线: IF/ID/EX/MEM/WB
//   - 11 个 Plugin 按 EARLY → NORMAL → LATE 顺序注册 (CPUFactory 单一真相源)
//   - 模板参数化 <typename T>: T = xlen (uint32/uint64)
//
// 借鉴:
//   - TLM 版本: ip/cpu/cpu_factory.h
//   - CppHDL/examples/riscv-mini/src/rv32i_pipeline.h (5-stage 完整实现)
//   - VexRiscv Pipeline.build() 调度顺序
//
// 约束:
//   - 必须 -DCF_PLUGIN_USE_CH_MEM
//   - D4 合规: 工厂只做 Plugin 注册, 不做业务逻辑
//   - 5 级流水线 CH_MEM 版本 (PoC): 用 select() 树 + ch_reg 跨阶段寄存器
//
// 注: 本文件是 Phase 6c M4 集成骨架, 完整 RTL sim 验证需要 build 环境.
//      PoC 目标是 5-stage Verilog 生成 + riscv-tests tohost=1 验证 (W7-8 M5 后).

#ifndef CF_IP_CPU_CPU_FACTORY_CHMEM_H
#define CF_IP_CPU_CPU_FACTORY_CHMEM_H

#ifndef CF_PLUGIN_USE_CH_MEM
#error "cpu_factory_chmem.h requires CF_PLUGIN_USE_CH_MEM"
#endif

#include <cstdint>
#include <memory>

#include <ch.hpp>
#include <core/context.h>
#include <core/uint.h>

#include "cf/plugin/plugin_base.h"
#include "cf/plugin/pipe_builder.h"
#include "cf/plugin/payload.h"
#include "cf/plugin/ctrl_link.h"
#include "cf/plugin/uint_t.h"

#include "ip/cpu/plugins/reg_file_chmem.h"
#include "ip/cpu/arch/riscv/int_alu_chmem.h"
#include "ip/cpu/arch/riscv/decoder_table.h"
#include "ip/cpu/core/payload_common.h"
#include "ip/cpu/arch/riscv/payload_riscv.h"

using namespace cf::plugin;
using namespace ch;
using namespace ch::core;

namespace cf {
namespace cpu {

// ============================================================================
// CpuFactoryChmem<T>: 5 级流水线 CPU 集成 (CH_MEM)
//
// 阶段名 (VexRiscv 风格):
//   - "fetch"      (IF  阶段): 取指
//   - "decode"     (ID  阶段): 译码 + 读寄存器
//   - "execute"    (EX  阶段): ALU 计算 + Branch 决策
//   - "memory"     (MEM 阶段): Memory 访问 (PoC 简化: no-op)
//   - "writeback"  (WB  阶段): 写回寄存器
//
// 跨阶段 Payload 字段 (VexRiscv Pipeline.build() Phase 5 风格):
//   fetch.output(PC) → decode.input(PC)
//   fetch.output(INSTRUCTION) → decode.input(INSTRUCTION)
//   decode.output(RS1/RS2) → execute.input(RS1/RS2)
//   decode.output(RISCV_DETAIL) → execute.input(RISCV_DETAIL)
//   execute.output(RESULT) → writeback.input(RESULT)
//   execute.output(RD_DATA) → writeback.input(RD_DATA)
//
// PoC 简化 (W7-8):
//   - DecoderPlugin / BranchPlugin / HazardPlugin 完整 CH_MEM 改写待 Phase 6d
//   - Memory 阶段简化: 写回值直接 pass-through
//   - Hazard 检测: 暂时无 (单周期 PoC 足够验证 add/addi/auipc/jal/beq)
// ============================================================================
template <typename T>
class CpuFactoryChmem {
  static_assert(std::is_unsigned<T>::value,
                "CpuFactoryChmem<T>: T must be unsigned (uint32/uint64)");
  static constexpr std::size_t kXlenBits = sizeof(T) * 8;

 public:
  using RegFile = plugins::RegFilePlugin<T>;
  using IntAlu = arch::riscv::RiscvIntAluPlugin<T>;

  // build_cpu (CH_MEM): 接受 ch::core::context*, 注册所有 Plugin, 返回 PipeBuilder
  // 阶段编排: register_plugin → build() → elaborate()
  static std::unique_ptr<PipeBuilder> build_cpu(
      ch::core::context* elaboration_ctx,
      T* /*memory*/ = nullptr /* PoC: no mem model */,
      T initial_pc = T{0x80000000}) {
    auto pb = std::make_unique<PipeBuilder>(elaboration_ctx);

    // ========================================================================
    // 阶段 1: StageLinkPlugin (cpu-pipeline-stubs-replace commit B)
    //          阶段间 Payload 传播 (PoC: 简化, M5 完整实现)
    // ========================================================================
    // 注: StageLinkPlugin 是 IF/ID/EX/MEM/WB 跨阶段 Payload 自动传播.
    //     CH_MEM 模式下, 自实现 at_stage 闭包发射 ch_reg 跨阶段连线.
    //     完整实装待 M5.
    // ========================================================================

    // ========================================================================
    // 阶段 2: RegFilePlugin (CH_MEM) - 32 ch_reg + select 读/写
    // ========================================================================
    pb->register_plugin(std::make_unique<RegFile>());

    // ========================================================================
    // 阶段 3: HazardPlugin (PoC: 简化版, Phase 6d 完整)
    // ========================================================================
    // PoC: 不实现 hazard 检测, 单周期假设
    // 完整实现 (Phase 6d) 需要:
    //   - detect_raw_hazard(rs1, rs2, ex_rd_addr, ex_rd_we) 组合逻辑
    //   - halt_when(raw_hazard) 注册到 fetch stage CtrlLink
    //   - stall 接到 stage valid/ready 门控
    // ========================================================================

    // ========================================================================
    // 阶段 4: RiscvIntAluPlugin (CH_MEM) - if/else → select 树
    // ========================================================================
    pb->register_plugin(std::make_unique<IntAlu>());

    // ========================================================================
    // 阶段 5-8: DecoderPlugin + BranchPlugin (PoC: 简化, Phase 6d 完整)
    // ========================================================================
    // 注: PoC 阶段, 译码/分支决策用 select 树简化表达. 完整 RTL sim 需要:
    //   - DecoderPlugin: 32 位指令 → opcode/funct3/funct7/rd/rs1/rs2/imm select 树
    //   - BranchPlugin: branch_taken/branch_target select 树
    //   - 实际 CpuFactory<cpu_factory.h> 的 Wiring 通过 PluginOrder 完成 (M4.1 P0)
    // ========================================================================

    // ========================================================================
    // PoC: PC 初始化 (Phase 6c W7-8 阶段)
    //   完整 CPU 需要从 memory[initial_pc] 取第一条指令 (IF 阶段).
    //   本 PoC 简化: 直接 hardcode PC = initial_pc (跳过真实 memory model)
    // ========================================================================
    (void)initial_pc;

    return pb;
  }

  // CPUConfig 简化版 (Phase 6c PoC; 完整 CPUConfig 见 cpu_factory.h)
  struct Config {
    T initial_pc = T{0x80000000};
    std::size_t pipeline_stages = 5;
    bool enable_mmu = false;
  };
};

}  // namespace cpu
}  // namespace cf

#endif  // CF_IP_CPU_CPU_FACTORY_CHMEM_H