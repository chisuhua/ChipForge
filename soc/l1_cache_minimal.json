{
  "name": "L1CacheMinimalSoC",
  "description": "Phase 1.3 minimal SoC topology — traffic_gen -> L1CachePlugin (Bridge) -> Memory (DRAM model). Validates Plugin-style L1Cache via cpptlm ModuleFactory JSON path. See .omo/drafts/decision-phase-1.3-bridge-2026-06-10.md §4 (D1=C + D1' contract).",
  "impl_mode": "TLM_ONLY",
  "modules": [
    {
      "name": "tg",
      "type": "TrafficGenTLM",
      "params": {
        "pattern": "SEQUENTIAL",
        "start_addr": "0x1000",
        "end_addr": "0x2000",
        "num_requests": 1000
      }
    },
    {
      "name": "l1",
      "type": "L1CacheTLMBridge",
      "params": {
        "num_sets": 256,
        "tag_bits": 20,
        "idx_bits": 8,
        "line_data_bits": 512
      }
    },
    {
      "name": "mem",
      "type": "MemoryTLM",
      "params": {
        "size_bytes": "1MB",
        "latency_cycles": 50
      }
    }
  ],
  "connections": [
    {
      "src": "tg",
      "dst": "l1",
      "latency": 1
    },
    {
      "src": "l1",
      "dst": "mem",
      "latency": 100
    }
  ]
}